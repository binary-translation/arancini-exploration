{
    "machines": [
        {
            "url": "localhost",
            "arch": "aarch64",
            "user": "$USER",
            "arancini_root": "$HOME/arancini-exploration"
        }
    ],
    "prefixes": {
            "results": "result-",
            "translations": "txlat-",
            "translations-fast": "txlat-fast-",
            "tx-df": "txlat-nodeadflags-",
            "tx-df-fast": "txlat-nodeadflags-fast-",
            "tx-fm": "txlat-nofencemerge-",
            "tx-fm-fast": "txlat-nofencemerge-fast-",
            "lasagne": "mctoll-"
    },
    "benchmarks": {
        "phoenix": {
            "bins": [
                {
                    "name": "histogram",
                    "args": [
                        { "name": "small.bmp", "type": "datafile" }
                    ]
                },
                {
                    "name": "kmeans",
                    "args": []
                },
                {
                    "name": "linear_regression",
                    "args": [
                        { "name": "key_file_50MB.txt", "type": "datafile" }
                    ]
                },
                {
                    "name": "matrix_multiply",
                    "args": [
                        { "name": "1024 1024 0", "type": "literal" }
                    ]
                },
                {
                    "name": "pca",
                    "args": []
                },
                {
                    "name": "string_match",
                    "args": [
                        { "name": "key_file_50MB.txt", "type": "datafile" }
                    ]
                },
                {
                    "name": "word_count",
                    "args": [
                        { "name": "word_10MB.txt", "type": "datafile" }
                    ]
                }
            ],
            "x86_64": "phoenix-x86_64",
            "aarch64": "phoenix-aarch64/aarch64-linux",
            "riscv64": "phoenix-riscv64/riscv64-linux"
        },
        "parsec": {
            "bins": [
            ],
            "x86_64": "parsec-x86_64",
            "aarch64": "parsec-aarch64",
            "riscv64": "parsec-riscv64"
        }
    },
    "emulators": [
        {
        "name": "native",
        "what": "native",
        "bin": "",
        "threads": [1, 2, 4, 8, 16, 32, 64]
        },
        {
        "name": "arancini-no-df",
        "what": "static",
        "tx": "tx-df",
        "threads": [1, 2, 4, 8, 16, 32, 64]
        },
        {
        "name": "arancini-no-df+nlib",
        "what": "static",
        "tx": "tx-df-fast",
        "threads": [1, 2, 4, 8, 16, 32, 64]
        },
        {
        "name": "arancini-no-fm",
        "what": "static",
        "tx": "tx-fm",
        "threads": [1, 2, 4, 8, 16, 32, 64]
        },
        {
        "name": "arancini-no-fm+nlib",
        "what": "static",
        "tx": "tx-fm-fast",
        "threads": [1, 2, 4, 8, 16, 32, 64]
        },
        {
        "name": "arancini",
        "what": "static",
        "tx": "translations",
        "threads": [1, 2, 4, 8, 16, 32, 64]
        },
        {
        "name": "arancini+nlib",
        "what": "static",
        "tx": "translations-fast",
        "threads": [1, 2, 4, 8, 16, 32, 64]
        },
        {
        "name": "qemu",
        "what": "dynamic",
        "bin": "risotto-qemu",
        "threads": [16]
        },
        {
        "name": "risotto",
        "what": "dynamic",
        "bin": "risotto",
        "threads": [16]
        },
        {
        "name": "risotto+nlib",
        "what": "dynamic",
        "bin": "risotto -nlib general.mni.aarch64.long",
        "threads": [16]
        },
        {
        "name": "lasagne",
        "what": "static",
        "tx": "lasagne",
        "threads": [16]
        }
    ]
}
